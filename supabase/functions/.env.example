# Edge function secrets for submit-request. Push them to Supabase with:
#   npx supabase secrets set --env-file supabase/functions/.env
# This file is git-ignored. Keep it that way.

# ── Gmail SMTP ─────────────────────────────────────────────
# SMTP_PASS must be a Gmail App Password (16 characters), not the normal Gmail password:
#   Google Account → Security → turn on 2-Step Verification → App passwords → create one for "Mail".
# Port 465 (SSL) is required: Supabase blocks outbound ports 25 and 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
FROM_NAME=Reno's Finest Details Website

# Where new requests are emailed (comma-separate to add more addresses)
OWNER_EMAIL=you@gmail.com

# Optional: lock the form to your site, e.g. https://renosfinestdetails.com,https://www.renosfinestdetails.com
# Leave empty to accept requests from any origin.
ALLOWED_ORIGINS=

# ── Service role key ───────────────────────────────────────
# Only used when running the function locally (npx supabase functions serve).
# On the hosted project Supabase provides it automatically, and `secrets set` skips SUPABASE_* names.
# Supabase → Project Settings → API Keys → service_role (secret). Never commit it or put it in the website .env.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
